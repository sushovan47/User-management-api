<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Otp Verification Code</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Verdana, sans-serif; background-color: #f4f6f9; color: #333333;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f4f6f9; padding: 40px 0;">
        <tr>
            <td>
                <table role="presentation" width="500" cellspacing="0" cellpadding="0" border="0" style="background-color: #ffffff; margin: 0 auto; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); overflow: hidden;">
                    <!-- Header Banner -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);padding: 20px 30px; text-align: center;">
                            <h2 style="color: #ffffff; margin: 0; font-size: 24px; font-weight: 600;">{{companyName}}</h2>
                        </td>
                    </tr>
                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 30px;">
                            <p style="margin: 0 0 16px 0; font-size: 16px; line-height: 1.5; color: #4b5563;">Hello <strong>{{userName}}</strong>,</p>
                            <p style="margin: 0 0 24px 0; font-size: 16px; line-height: 1.5; color: #4b5563;">We received a request to verify your identity. Use the verification code below to complete the process. This code is valid for <strong>{{expiryTime}} minutes</strong>.</p>
                            
                            <!-- OTP Box -->
                            <div style="background-color: #f3f4f6;color:darblue; border-radius: 6px; padding: 20px; text-align: center; margin-bottom: 24px; border: 1px dashed #cbd5e1;">
                                <span style="font-family: 'Courier New', Courier, monospace; font-size: 32px; font-weight: bold; letter-spacing: 6px; color: #1e1b4b;">{{otpCode}}</span>
                            </div>
                            
                            <p style="margin: 0 0 8px 0; font-size: 14px; line-height: 1.5; color: #6b7280; font-style: italic;">If you did not request this code, you can safely ignore this email.</p>
                        </td>
                    </tr>
                    <!-- Footer -->
                    <tr>
                        <td style="background: #222; padding: 20px 30px; text-align: center; border-top: 1px solid #e5e7eb;">
                            <p style="margin: 0; font-size: 12px; color: #9ca3af;">&copy; {{currentYear}} {{companyName}}. All rights reserved.</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
